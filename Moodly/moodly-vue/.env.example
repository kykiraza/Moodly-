# Adresse de l'API Strapi (avec /api à la fin).
# - Dans le navigateur du Mac : http://localhost:1337/api
# - Sur un téléphone (Capacitor ou Wi-Fi) : l'IP locale du Mac, ex. http://192.168.1.42:1337/api
#   (pour la trouver : `ipconfig getifaddr en0`). Téléphone et Mac sur le même Wi-Fi.
VITE_API_URL=http://localhost:1337/api
