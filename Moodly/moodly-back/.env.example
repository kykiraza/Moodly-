# Modèle du fichier .env (ce fichier-ci est commité, le vrai .env ne l'est JAMAIS).
# Le plus simple : lance `npm run setup`, qui crée .env et remplace tous les
# « tobemodified » par des secrets aléatoires.

# Serveur
HOST=0.0.0.0
PORT=1337

# Secrets Strapi
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Base de données (fichier SQLite local)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Moodly
# Clé secrète pour calculer le dailyKey (empreinte « 1 saisie par jour » sans lien vers l'utilisateur)
MOOD_SALT=tobemodified
# En dessous de ce nombre de réponses, une moyenne est masquée (anonymat)
MOOD_MIN_RESPONSES=3
# Les saisies plus vieilles que ça sont supprimées chaque nuit à 3h (RGPD : minimisation)
MOOD_RETENTION_DAYS=90
# Fuseau horaire qui définit « aujourd'hui »
APP_TIMEZONE=Europe/Paris

# Connexion avec Google / Apple / Microsoft (laisser vide = bouton désactivé côté serveur)
# Voir Moodly/moodly-native/GUIDE-CONNEXION-SOCIALE.md pour obtenir ces identifiants.
# Google : les ID client OAuth iOS, Android et Web, séparés par des virgules
GOOGLE_CLIENT_IDS=
# Apple : le bundle ID de l'app iOS
APPLE_CLIENT_IDS=fr.moodly.app
# Microsoft : l'« ID d'application (client) » de l'app déclarée dans Azure / Entra ID
MICROSOFT_CLIENT_ID=

# Inscription : exiger un mot de passe solide (8 caractères, 1 majuscule, 1 chiffre, 1 spécial).
# false = n'importe quel mot de passe est accepté (pratique pour la démo).
STRONG_PASSWORD=false

# Sauvegardes de la base (npm run backup + chaque nuit à 2h30). Conseillé : un dossier hors du projet.
BACKUP_DIR=backups
BACKUP_KEEP=14
