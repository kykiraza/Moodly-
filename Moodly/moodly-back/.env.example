# Modèle du fichier .env (ce fichier-ci est commité, le vrai .env ne l'est JAMAIS).
# Le plus simple : lance `npm run setup`, qui crée .env et remplace tous les
# « tobemodified » par des secrets aléatoires.

# Serveur
HOST=0.0.0.0
PORT=1337

# Secrets Strapi
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Base de données (fichier SQLite local)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Moodly
# Clé secrète pour calculer le dailyKey (empreinte « 1 saisie par jour » sans lien vers l'utilisateur)
MOOD_SALT=tobemodified
# En dessous de ce nombre de réponses, une moyenne est masquée (anonymat)
MOOD_MIN_RESPONSES=3
# Les saisies plus vieilles que ça sont supprimées chaque nuit à 3h (RGPD : minimisation)
MOOD_RETENTION_DAYS=90
# Fuseau horaire qui définit « aujourd'hui »
APP_TIMEZONE=Europe/Paris
