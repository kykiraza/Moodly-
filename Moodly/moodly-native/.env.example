# Copie ce fichier en .env.local (il n'est pas envoyé sur Git) et remplis-le.

# Adresse de l'API Strapi, avec /api à la fin.
# - Navigateur du Mac : http://localhost:1337/api
# - Téléphone : l'IP du Mac sur le Wi-Fi (`ipconfig getifaddr en0`), ex. http://192.168.1.42:1337/api
EXPO_PUBLIC_API_URL=http://localhost:1337/api

# Connexion Google (voir GUIDE-CONNEXION-SOCIALE.md) — vide = bouton Google désactivé
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# « iOS URL scheme » = l'ID client iOS à l'envers, ex. com.googleusercontent.apps.123-abc
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Connexion Microsoft (Azure / Entra ID) — vide = bouton Microsoft désactivé
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# Projet EAS (rempli par `npx eas-cli@latest init`)
EAS_PROJECT_ID=
